@startuml
top to bottom direction
skinparam nodesep 40
skinparam ranksep 50
skinparam packageStyle rectangle

title AI Native 测试流程架构

' ============= Harness 管理层 =============
package "Harness 管理层" #D6EAF8 {
  component "需求管理" as req_mgmt
  component "CodeMap 管理" as codemap_mgmt
  component "Spec 管理" as spec_mgmt
}

' ============= OpenSpec 执行层 =============
package "OpenSpec 执行层" #FCF3CF {
  component "需求" as requirement
  component "Spec" as spec
  component "测试用例" as test_case
  component "执行" as execution
  component "结果反馈" as feedback
}

' ============= Harness 编排层 =============
package "Harness 编排层" #FADBD8 {
  component "Test Workflow" as test_workflow
  component "Agents" as agents
  component "Rules" as rules
}

' ============= 资产层 =============
package "资产层" #EBDEF0 {
  database "Knowledge" as knowledge
  component "Test Spec" as test_spec
  component "CodeMap" as codemap
}

' ============= 流程定义 =============
req_mgmt --> requirement : 管理
codemap_mgmt --> codemap : 维护
spec_mgmt --> spec : 管理

requirement --> spec : 转换为
spec --> test_case : 生成
test_case --> execution : 执行
execution --> feedback : 产出

test_workflow --> agents : 激活
test_workflow --> rules : 遵循
agents --> test_spec : 访问规范
codemap --> test_workflow : 提供结构映射
test_spec --> test_workflow : 提供测试规范

feedback --> knowledge : 提升为长期资产
feedback --> req_mgmt : 闭环反馈

legend
  | 颜色 | 层级 | 说明 |
  |------|------|------|
  | <color:#D6EAF8>█</color> | Harness 管理层 | 需求、CodeMap、Spec 管理 |
  | <color:#FCF3CF>█</color> | OpenSpec 执行层 | 需求→Spec→测试用例→执行→反馈 |
  | <color:#FADBD8>█</color> | Harness 编排层 | 测试流程编排 |
  | <color:#EBDEF0>█</color> | 资产层 | Knowledge、Test Spec、CodeMap |
endlegend

@enduml
