#!/usr/bin/env bash
# pre-commit hook: validate repository governance constraints before commit.
#
# Installed via scripts/setup-hooks.sh (symlink to .git/hooks/pre-commit).
# Delegates to the unified hook dispatcher for all validation logic.
#
# The dispatcher reads harness/hooks/registry.yaml and matches validators
# by event=pre_commit + path_patterns against staged files.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Delegate to the unified dispatcher
python3 scripts/hooks/dispatch.py --run --event pre_commit --staged --verbose
