#!/usr/bin/env bash
# pre-commit hook: validate repository governance constraints before commit.
#
# Installed via scripts/setup-hooks.sh (symlink to .git/hooks/pre-commit).
# Runs different checks based on what files are staged.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# 获取所有 staged 的文件（包括新增、修改、删除）
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

HAS_ERROR=0

# ==========================================================================
# 检查 1: knowledge/ 下的 artifact.md / verdict.md
# ==========================================================================
KNOWLEDGE_FILES=""
for f in $STAGED_FILES; do
    case "$f" in
        knowledge/*/artifact.md|knowledge/*/verdict.md|knowledge/*/*/artifact.md|knowledge/*/*/verdict.md|knowledge/*/*/*/artifact.md|knowledge/*/*/*/verdict.md)
            KNOWLEDGE_FILES="$KNOWLEDGE_FILES $f"
            ;;
    esac
done

if [ -n "$KNOWLEDGE_FILES" ]; then
    echo "=== Pre-commit: Validating knowledge artifacts ==="

    # 1a. frontmatter + artifact contract 校验
    if ! python3 scripts/general/check_knowledge_artifacts.py $KNOWLEDGE_FILES; then
        HAS_ERROR=1
    fi

    # 1b. TOC 覆盖校验
    if ! python3 scripts/general/check_artifact_toc.py $KNOWLEDGE_FILES; then
        HAS_ERROR=1
    fi

    # 1c. 未归档 change 检查（advisory，不阻止 commit）
    python3 scripts/general/check_unarchived_changes.py || true
fi

# ==========================================================================
# 检查 2: openspec/changes/ 下的 request.md / plan.md
# ==========================================================================
PROCESS_FILES=""
for f in $STAGED_FILES; do
    case "$f" in
        openspec/changes/*/request.md|openspec/changes/*/plan.md)
            PROCESS_FILES="$PROCESS_FILES $f"
            ;;
    esac
done

if [ -n "$PROCESS_FILES" ]; then
    echo "=== Pre-commit: Validating process files ==="

    if ! python3 scripts/general/check_process_files.py $PROCESS_FILES; then
        HAS_ERROR=1
    fi
fi

# ==========================================================================
# 最终结果
# ==========================================================================
if [ "$HAS_ERROR" -eq 1 ]; then
    echo "Pre-commit validation FAILED. Commit blocked."
    exit 1
fi

echo "Pre-commit validation passed."
exit 0
