{
  "mcpServers": {
    "fastmcp-gateway": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:18080/mcp",
        "--allow-http",
        "--transport",
        "http-only"
      ],
      "env": {
        "NPM_CONFIG_CACHE": "/tmp/npm-cache",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      }
    },
    "crawl4ai": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "/Users/zhehan/Documents/tools/llm/skills/agent-skills/tools/crawl/crawl4ai/scripts/crawl4ai_mcp_stdio.py"
      ],
      "description": "Crawl4AI MCP server (stdio) - provides md, html, screenshot, pdf, execute_js, crawl, ask tools for web extraction"
    }
  }
}