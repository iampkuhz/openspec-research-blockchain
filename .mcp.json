{
  "mcpServers": {
    "fastmcp-gateway": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:18080/mcp",
        "--allow-http",
        "--transport",
        "http-only"
      ],
      "env": {
        "NPM_CONFIG_CACHE": "/tmp/npm-cache",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      }
    }
  }
}
