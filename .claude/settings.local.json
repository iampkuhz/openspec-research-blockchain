{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "HTTPS_PROXY": "http://127.0.0.1:7890",
    "HTTP_PROXY": "http://127.0.0.1:7890",
    "NO_PROXY": "localhost,127.0.0.1,::1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "permissions": {
    "allow": [
      "Edit(.claude)",
      "Write(.claude)",
      "MultiEdit(.claude)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "MultiEdit(.claude/**)",
      "Bash(mkdir -p .claude/*)",
      "Bash(rm .claude/*)",
      "Bash(rm -r .claude/*)",
      "Bash(rm -rf .claude/*)",
      "Bash(ln -s * .claude/*)",
      "Bash(cp * .claude/*)",
      "Bash(mv * .claude/*)",
      "Bash(git mv:*)",
      "Bash(find /Users/zhehan/Documents/tools/llm/openspec/openspec-research-blockchain -name *plantuml* -o -name *feipi*)",
      "Bash(ln -s ../../skills/openspec-research-build-artifact /Users/zhehan/Documents/tools/llm/openspec/openspec-research-blockchain/.qoder/skills/openspec-research-build-artifact)",
      "Bash(ln:*)",
      "Bash(find /Users/zhehan/Documents/tools/llm/openspec/openspec-research-blockchain -name *build-request* -o -name *request*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "language": "chinese",
  "effortLevel": "high"
}
