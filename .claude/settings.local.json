      "Bash(find /Users/zhehan/Documents/tools/llm/openspec/openspec-research-blockchain -name *plantuml* -o -name *feipi*)",
      "Bash(ln -s ../../skills/openspec-research-build-artifact /Users/zhehan/Documents/tools/llm/openspec/openspec-research-blockchain/.qoder/skills/openspec-research-build-artifact)",
