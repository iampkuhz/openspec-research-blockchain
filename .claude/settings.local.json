{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "max",
  "language": "chinese",
  "env": {
    "HTTPS_PROXY": "http://127.0.0.1:7890",
    "HTTP_PROXY": "http://127.0.0.1:7890",
