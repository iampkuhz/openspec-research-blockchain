{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "model": "litellm-code-anthropic",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/dispatch.py --run --event post_tool_use --files \"$(jq -r '.tool_response.filePath // .tool_input.file_path' 2>/dev/null)\"",
            "timeout": 60,
            "statusMessage": "Running hook validations..."
          }
        ]
      }
    ]
  }
}
