{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "chinese",
  "model": "litellm-code-anthropic",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/zhehan/Documents/tools/llm/openspec/openspec-research-blockchain && python3 scripts/hooks/dispatch.py --event post_write --files \"$(jq -r '.tool_response.filePath // .tool_input.file_path' 2>/dev/null)\"",
            "timeout": 60,
            "statusMessage": "Running hook validations...",
            "if": "filePath contains 'openspec/changes/'"
          }
        ]
      }
    ]
  }
}
